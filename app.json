{
  "expo": {
    "name": "大肥鱼",
    "slug": "big-fat-fish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bigfatfish",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.waynelee97.big-fat-fish",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "允许班主任工作台访问麦克风，用于录制日程语音。",
        "NSLocalNetworkUsageDescription": "允许大肥鱼连接同一局域网内的教室电脑并发送通知。",
        "NSBonjourServices": [
          "_bigfatfish._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "允许班主任工作台访问相机，用于拍摄日程照片和通知 OCR 识别。",
          "photosPermission": "允许班主任工作台访问相册，用于添加日程照片和选择通知图片进行 OCR 识别。",
          "microphonePermission": "允许班主任工作台访问麦克风，用于录制日程语音。"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许班主任工作台访问麦克风，用于录制日程语音。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许大肥鱼使用相机扫描配对二维码、拍摄日程照片和进行通知 OCR 识别。",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "./plugins/withClassroomNetwork"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
